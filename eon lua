    local charFX = {}
    local function clearCharFX()
        for _, o in ipairs(charFX) do pcall(function() o:Destroy() end) end
        charFX = {}
    end

    local function applyCharFX()
        clearCharFX()
        local ch = LocalPlayer.Character
        if not ch then return end
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        if st.charGlow then
            local l = Instance.new("PointLight")
            l.Brightness=3; l.Range=15; l.Color=Color3.fromRGB(255,255,255); l.Parent=hrp
            table.insert(charFX, l)
        end
        if st.charRGB then
            local l = Instance.new("PointLight")
            l.Brightness=4; l.Range=18; l.Parent=hrp
            table.insert(charFX, l)
            task.spawn(function()
                while l.Parent do
                    l.Color = Color3.fromHSV((tick()*0.3)%1, 0.9, 1)
                    task.wait(0.05)
                end
            end)
        end
        if st.charTrail then
            local a0 = Instance.new("Attachment"); a0.Position=Vector3.new(1,0,0); a0.Parent=hrp
            local a1 = Instance.new("Attachment"); a1.Position=Vector3.new(-1,0,0); a1.Parent=hrp
            local tr = Instance.new("Trail")
            tr.Attachment0=a0; tr.Attachment1=a1; tr.Lifetime=0.5
            tr.Color = ColorSequence.new(C.white)
            tr.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.3),
                NumberSequenceKeypoint.new(1, 1)
            })
            tr.Parent = hrp
            table.insert(charFX, a0); table.insert(charFX, a1); table.insert(charFX, tr)
        end
        if st.charSparkles then
            local s = Instance.new("Sparkles"); s.SparkleColor=Color3.fromRGB(255,255,255); s.Parent=hrp
            table.insert(charFX, s)
        end
        if st.charFire then
            local f = Instance.new("Fire")
            f.Size=4; f.Heat=8
            f.Color=Color3.fromRGB(255,120,50); f.SecondaryColor=Color3.fromRGB(255,200,100)
            f.Parent = hrp
            table.insert(charFX, f)
        end
        if st.charFrozen then
            local p = Instance.new("ParticleEmitter")
            p.Texture = "rbxassetid://243660364"
            p.Rate = 30; p.Speed = NumberRange.new(1, 3)
            p.Lifetime = NumberRange.new(0.5, 1)
            p.Color = ColorSequence.new(Color3.fromRGB(150, 220, 255))
            p.Size = NumberSequence.new(0.4)
            p.Parent = hrp
            table.insert(charFX, p)
        end
        if st.charLightning then
            local p = Instance.new("ParticleEmitter")
            p.Texture = "rbxassetid://243098098"
            p.Rate = 5; p.Speed = NumberRange.new(0, 2)
            p.Lifetime = NumberRange.new(0.2, 0.5)
            p.Color = ColorSequence.new(Color3.fromRGB(255, 255, 100))
            p.Size = NumberSequence.new(0.6)
            p.Parent = hrp
            table.insert(charFX, p)
        end
        if st.charHearts then
            local p = Instance.new("ParticleEmitter")
            p.Texture = "rbxassetid://7136670107"
            p.Rate = 5; p.Speed = NumberRange.new(2, 4)
            p.Lifetime = NumberRange.new(1, 2)
            p.Color = ColorSequence.new(Color3.fromRGB(255, 100, 150))
            p.Size = NumberSequence.new(0.5)
            p.Parent = hrp
            table.insert(charFX, p)
        end
        if st.charNotes then
            local p = Instance.new("ParticleEmitter")
            p.Texture = "rbxassetid://8072541754"
            p.Rate = 5; p.Speed = NumberRange.new(2, 4)
            p.Lifetime = NumberRange.new(1, 2)
            p.Color = ColorSequence.new(Color3.fromRGB(255, 255, 150))
            p.Size = NumberSequence.new(0.5)
            p.Parent = hrp
            table.insert(charFX, p)
        end
        if st.charFireflies then
            local p = Instance.new("ParticleEmitter")
            p.Rate = 15; p.Speed = NumberRange.new(0.5, 2)
            p.Lifetime = NumberRange.new(1, 3)
            p.Color = ColorSequence.new(Color3.fromRGB(255, 255, 100))
            p.Size = NumberSequence.new(0.3)
            p.LightEmission = 1
            p.Parent = hrp
            table.insert(charFX, p)
        end
        if st.charHalo then
            local halo = Instance.new("SelectionSphere")
            halo.Adornee = hrp
            halo.Color3 = Color3.fromRGB(255, 220, 100)
            halo.Transparency = 0.5
            halo.SurfaceTransparency = 0.5
            halo.Parent = hrp
            table.insert(charFX, halo)
        end
        if st.charRainbow then
            local l = Instance.new("PointLight")
            l.Brightness = 3; l.Range = 20; l.Parent = hrp
            table.insert(charFX, l)
            task.spawn(function()
                while l.Parent do
                    l.Color = Color3.fromHSV((tick()*0.5)%1, 1, 1)
                    task.wait(0.05)
                end
            end)
        end
        if st.charGhost then
            for _, part in ipairs(ch:GetChildren()) do
                if part:IsA("BasePart") then
                    part.Transparency = 0.6
                end
            end
        end
        if st.headSize ~= "normal" then
            local head = ch:FindFirstChild("Head")
            if head then
                local size = st.headSize == "big" and Vector3.new(2, 2, 2) or Vector3.new(0.5, 0.5, 0.5)
                head.Size = size
                head.Massless = true
            end
        end
        if st.bodySize ~= "normal" then
            local torso = ch:FindFirstChild("Torso") or ch:FindFirstChild("UpperTorso")
            if torso then
                if st.bodySize == "wide" then torso.Size = Vector3.new(3, 2, 1)
                elseif st.bodySize == "tall" then torso.Size = Vector3.new(2, 4, 1)
                elseif st.bodySize == "small" then torso.Size = Vector3.new(1, 1, 0.5) end
            end
        end
        if st.bodyColor then
            for _, part in ipairs(ch:GetChildren()) do
                if part:IsA("BasePart") then part.Color = st.bodyColor end
            end
            if ch:FindFirstChild("Head") then ch.Head.Color = st.bodyColor end
            for _, v in ipairs(ch:GetDescendants()) do
                if v:IsA("Decal") then v.Transparency = 1 end
            end
        end
    end
